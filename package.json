{
    "name": "diplomacy-api",
    "main": "index.js",
    "packageManager": "yarn@4.12.0",
    "scripts": {
        "postinstall": "yarn dlx @yarnpkg/sdks base",
        "format": "prettier --write .",
        "test": "vitest",
        "build": "yarn format && webpack --mode=production && zip -j dist/index.zip dist/index.js",
        "publish": "yarn build && cd terraform && terraform apply",
        "run:board": "yarn format && ts-node -r tsconfig-paths/register event-mocks/board.event.ts",
        "run:orders": "yarn format && ts-node -r tsconfig-paths/register event-mocks/orders.event.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.962.0",
        "@aws-sdk/client-secrets-manager": "3.962.0",
        "mongodb": "7.0.0",
        "pureimage": "0.4.18"
    },
    "devDependencies": {
        "@types/aws-lambda": "8.10.159",
        "@types/node": "24.7.2",
        "node-loader": "2.1.0",
        "prettier": "3.6.2",
        "ts-loader": "9.5.4",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "typescript": "5.9.3",
        "vitest": "4.0.18",
        "webpack": "5.102.1",
        "webpack-cli": "^6.0.1"
    },
    "prettier": {
        "tabWidth": 4,
        "useTabs": false
    }
}
